# ============================================================
#  RPG Multiplayer com Gemini - variaveis de ambiente
#  Copie este arquivo para ".env" e preencha os valores.
#  NUNCA envie o arquivo .env para o GitHub nem para o ZIP.
# ============================================================

# --- Servidor ---
PORT=3000
# Segredo usado para assinar os JWT (use uma string longa e aleatoria)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_EM=7d

# --- Banco de dados (MySQL 8.0.16 ou superior) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rpg_gemini
# true = executa database/schema.sql automaticamente ao iniciar (idempotente)
AUTO_MIGRATE=true

# --- Gemini (Google GenAI) ---
# Chave criada em https://aistudio.google.com/apikey  (fica SO no back-end)
# Deixe vazio para rodar em MODO DEMONSTRACAO (Mestre e imagens simulados).
GEMINI_API_KEY= asasasdahdgjsadhygj
# Modelo de texto (Mestre do Jogo e NPCs)
GEMINI_TEXT_MODEL=gemini-3.5-flash
# Modelo de imagem (Nano Banana). Aceita tambem modelos "imagen-*".
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# true = forca o modo demonstracao mesmo com chave preenchida
GEMINI_MOCK=false

# Estilo padronizado dos prompts de imagem (opcional)
AVATAR_STYLE=concept art, digital painting, dramatic lighting, fantasy RPG character portrait, head and shoulders, highly detailed, no text, no watermark
CENARIO_STYLE=concept art, digital painting, cinematic wide establishing shot, atmospheric lighting, highly detailed environment, no text, no watermark

# --- Regras do jogo (opcional) ---
MAX_MAPAS=5
MIN_ACOES_POR_MAPA=2

# --- So para demonstracao (modo sem chave) ---
# Probabilidade (0 a 1) de o Mestre simulado devolver erro 429, para mostrar o aviso de rate limit na interface.
# MOCK_SIMULAR_429=0.3
DB_USER=rpg
DB_PASSWORD=rpg123
JWT_SECRET=qualquer-texto-longo-aqui